<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DarktideModManager</AssemblyName>
    <RootNamespace>DarktideModManager</RootNamespace>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\nexus-mods.png" LogicalName="DarktideModManager.Assets.nexus-mods.png" />
    <EmbeddedResource Include="Assets\darktide-steam.jpg" LogicalName="DarktideModManager.Assets.darktide-steam.jpg" />
  </ItemGroup>
</Project>
